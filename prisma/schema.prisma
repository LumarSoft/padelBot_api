generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// A club (tenant). Every tenant-scoped record relates back to a Club.
model Club {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// MercadoPago alias/CVU players transfer the deposit to. Null until the owner configures it.
  transferAlias  String?
  /// Account holder name shown to players alongside the alias ("titular").
  transferHolder String?

  /// How much the bot asks the player to transfer to confirm a booking:
  /// DEPOSIT = a partial deposit (seña) of `depositPercent` of the court price,
  /// FULL = the whole court price. The owner sets this per club.
  depositMode    DepositMode @default(DEPOSIT)
  /// Percentage of the court price charged as the seña when depositMode = DEPOSIT.
  /// Default 25 (one of four padel players). Ignored when depositMode = FULL.
  depositPercent Int         @default(25)

  /// MercadoPago Connect (OAuth) — each club connects its OWN MP account so the deposit
  /// money lands in the club's account and the poller can reconcile it with that account's
  /// token. Null until the owner connects MercadoPago. Tokens are stored ENCRYPTED at rest.
  mpAccessToken    String?  @db.Text
  mpRefreshToken   String?  @db.Text
  /// MercadoPago user id of the connected account (its own, for display / debugging).
  mpUserId         String?
  /// When the connected access token expires; the poller refreshes it before then.
  mpTokenExpiresAt DateTime?
  /// When the owner connected MercadoPago (null = not connected).
  mpConnectedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  courts               Court[]
  slots                Slot[]
  bookings             Booking[]
  recurringBookings    RecurringBooking[]
  whatsappLines        WhatsAppLine[]
  conversationSessions ConversationSession[]
}

enum Role {
  OWNER
  STAFF
}

/// Whether the bot charges a partial deposit (seña) or the full court price.
enum DepositMode {
  DEPOSIT
  FULL
}

/// A physical court the club offers slots on.
model Court {
  id        String   @id @default(cuid())
  name      String
  /// Price (in cents) for every slot on this court.
  priceCents Int     @default(0)
  /// Wall-clock time ("HH:MM") when the first daily slot starts.
  openTime  String   @default("09:00")
  /// Wall-clock time ("HH:MM") when the last daily slot ends; "00:00" means midnight.
  closeTime  String    @default("00:00")
  courtType  CourtType @default(INDOOR)
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  slots     Slot[]
  recurringBookings RecurringBooking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
}

enum CourtType {
  INDOOR
  OUTDOOR
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

/// A bookable time slot (turno) on a court. Prices are stored in cents.
model Slot {
  id         String     @id @default(cuid())
  courtId    String
  court      Court      @relation(fields: [courtId], references: [id], onDelete: Cascade)
  clubId     String
  club       Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  priceCents Int
  status     SlotStatus @default(AVAILABLE)
  bookings   Booking[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  /// A court can only have one slot per start time. Guarantees that
  /// concurrent admin + bot bookings on an empty band cannot duplicate a slot.
  @@unique([courtId, startsAt])
  @@index([clubId])
  @@index([clubId, startsAt])
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  password         String
  name             String
  role             Role               @default(STAFF)
  clubId           String
  club             Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  recurringBookings RecurringBooking[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([clubId])
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

/// A reservation linking a player to a specific slot.
model Booking {
  id                 String            @id @default(cuid())
  slotId             String
  slot               Slot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  clubId             String
  club               Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerName         String
  playerPhone        String?
  status             BookingStatus     @default(PENDING_PAYMENT)
  notes              String?
  bookedByUserId     Int?
  bookedByUser       User?             @relation(fields: [bookedByUserId], references: [id])
  recurringBookingId String?
  recurringBooking   RecurringBooking? @relation(fields: [recurringBookingId], references: [id], onDelete: SetNull)
  /// Amount (cents) the first player must pay to confirm this slot.
  depositCents       Int               @default(0)
  /// Exact amount (cents) the player must transfer. Normally equals the real deposit;
  /// only on a collision with another pending booking in the same whole-peso bucket is
  /// a different centavos tag chosen, so an incoming transfer still maps to exactly one
  /// pending booking during reconciliation. Null for admin-created bookings.
  transferAmountCents Int?
  /// MercadoPago payment ID set once the webhook confirms the payment.
  mpPaymentId        String?
  /// When the pending payment link expires; null for admin-created bookings.
  paymentExpiresAt   DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([clubId])
  @@index([slotId])
  @@index([recurringBookingId])
  @@index([clubId, status])
  @@index([status, paymentExpiresAt])
  @@index([status, transferAmountCents])
}

/// Maps a Meta WhatsApp Business phone number ID to a club (tenant).
/// The bot uses this to resolve which club owns an incoming message.
model WhatsAppLine {
  id            String   @id @default(cuid())
  /// Meta's phone_number_id from the webhook — globally unique across all clubs.
  phoneNumberId String   @unique
  /// Human-readable phone number for display (e.g. "+54 9 11 1234-5678").
  displayPhone  String
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clubId])
}

/// Bot conversation state for a WhatsApp user within a club.
/// Persists the state machine position and partial booking data between messages.
model ConversationSession {
  id        String   @id @default(cuid())
  /// WhatsApp sender ID (phone in E.164 without '+', e.g. "5491112345678").
  waId      String
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// Current state machine node (BotState enum value stored as string).
  state     String   @default("IDLE")
  /// Partial booking/cancel data accumulated across turns (JSON blob).
  context   Json
  /// Session expires after inactivity; reset to IDLE on next message.
  expiresAt DateTime
  /// "AI" = bot handles the conversation; "HUMAN" = admin has taken over.
  mode      String   @default("AI")
  /// Cached player name from context so the conversations list can display it without loading context.
  playerName String?
  messages  ConversationMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([waId, clubId])
  @@index([clubId])
}

/// Persistent log of every message in a conversation (incoming, bot replies, admin replies).
model ConversationMessage {
  id        String              @id @default(cuid())
  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// "USER" = from the player, "BOT" = generated by the AI, "ADMIN" = sent manually by staff.
  role      String
  content   String              @db.Text
  createdAt DateTime            @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

/// Dedup log of WhatsApp webhook messages already handled. Meta retries webhook
/// deliveries (on slow/non-200 responses), so we record each Meta message id and skip
/// re-processing — prevents double bookings / duplicate LLM calls. Rows are pruned daily.
model ProcessedWebhookMessage {
  /// Meta's message id (wamid…), globally unique per message.
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A weekly recurring reservation created by an admin.
/// When created, it is automatically applied to all matching available slots.
model RecurringBooking {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courtId         String
  court           Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  /// 0 = Sunday, 1 = Monday … 6 = Saturday
  dayOfWeek       Int
  /// "HH:MM" matching one of the defined slot start times
  slotStart       String
  /// "HH:MM" matching one of the defined slot end times
  slotEnd         String
  playerName      String
  playerPhone     String
  priceCents      Int
  notes           String?
  isActive        Boolean   @default(true)
  createdByUserId Int
  createdByUser   User      @relation(fields: [createdByUserId], references: [id])
  bookings        Booking[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clubId])
  @@index([courtId])
  @@index([clubId, courtId, dayOfWeek])
}
