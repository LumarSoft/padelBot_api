generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// A club (tenant). Every tenant-scoped record relates back to a Club.
model Club {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// MercadoPago alias/CVU players transfer the deposit to. Null until the owner configures it.
  transferAlias  String?
  /// Account holder name shown to players alongside the alias ("titular").
  transferHolder String?

  /// How much the bot asks the player to transfer to confirm a booking:
  /// DEPOSIT = a partial deposit (seña) of `depositPercent` of the court price,
  /// FULL = the whole court price. The owner sets this per club.
  depositMode    DepositMode @default(DEPOSIT)
  /// Percentage of the court price charged as the seña when depositMode = DEPOSIT.
  /// Default 25 (one of four padel players). Ignored when depositMode = FULL.
  depositPercent Int         @default(25)

  /// When true, the bot asks the player's DNI at booking, the transfer amount is a clean
  /// round number (no centavos tag), and a transfer auto-confirms only if the payer's DNI
  /// (from MercadoPago) matches the reservation's. Mismatch/unknown → manual review.
  requireDniMatch Boolean    @default(false)

  /// How the club verifies the player's deposit:
  /// AUTO    = the poller reconciles the transfer against MercadoPago automatically.
  /// RECEIPT = the bot asks the player to send a photo of the transfer receipt and an
  ///           admin verifies it manually from the panel (no MercadoPago reconciliation).
  paymentVerificationMode PaymentVerificationMode @default(AUTO)

  /// MercadoPago Connect (OAuth) — each club connects its OWN MP account so the deposit
  /// money lands in the club's account and the poller can reconcile it with that account's
  /// token. Null until the owner connects MercadoPago. Tokens are stored ENCRYPTED at rest.
  mpAccessToken    String?  @db.Text
  mpRefreshToken   String?  @db.Text
  /// MercadoPago user id of the connected account (its own, for display / debugging).
  mpUserId         String?
  /// When the connected access token expires; the poller refreshes it before then.
  mpTokenExpiresAt DateTime?
  /// When the owner connected MercadoPago (null = not connected).
  mpConnectedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  courts               Court[]
  courtPriceRules      CourtPriceRule[]
  slots                Slot[]
  bookings             Booking[]
  recurringBookings    RecurringBooking[]
  whatsappLines        WhatsAppLine[]
  conversationSessions ConversationSession[]
  paymentReceipts      PaymentReceipt[]
  deviceTokens         DeviceToken[]
  products             Product[]
  bookingProducts      BookingProduct[]
}

enum Role {
  OWNER
  STAFF
}

/// Whether the bot charges a partial deposit (seña) or the full court price.
enum DepositMode {
  DEPOSIT
  FULL
}

/// How a club verifies the deposit transfer: automatically via MercadoPago, or by a
/// receipt photo the player sends, reviewed manually by an admin in the panel.
enum PaymentVerificationMode {
  AUTO
  RECEIPT
}

/// A physical court the club offers slots on.
model Court {
  id        String   @id @default(cuid())
  name      String
  /// Price (in cents) for every slot on this court.
  priceCents Int     @default(0)
  /// Wall-clock time ("HH:MM") when the first daily slot starts.
  openTime  String   @default("09:00")
  /// Wall-clock time ("HH:MM") when the last daily slot ends; "00:00" means midnight.
  closeTime  String    @default("00:00")
  courtType  CourtType @default(INDOOR)
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  slots     Slot[]
  recurringBookings RecurringBooking[]
  priceRules CourtPriceRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
}

/// Per-time-band price exception for a court. When present, it overrides the court's
/// default `priceCents` for slots starting at `startTime`. `dayOfWeek` null = applies
/// every day; a day-specific rule (matching weekday) takes precedence over an all-days one.
model CourtPriceRule {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courtId    String
  court      Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday, or null for every day.
  dayOfWeek  Int?
  /// "HH:MM" start of the schedule band this price applies to.
  startTime  String
  priceCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([courtId, dayOfWeek, startTime])
  @@index([clubId])
  @@index([courtId])
}

enum CourtType {
  INDOOR
  OUTDOOR
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

/// A bookable time slot (turno) on a court. Prices are stored in cents.
model Slot {
  id         String     @id @default(cuid())
  courtId    String
  court      Court      @relation(fields: [courtId], references: [id], onDelete: Cascade)
  clubId     String
  club       Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  priceCents Int
  status     SlotStatus @default(AVAILABLE)
  bookings   Booking[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  /// A court can only have one slot per start time. Guarantees that
  /// concurrent admin + bot bookings on an empty band cannot duplicate a slot.
  @@unique([courtId, startsAt])
  @@index([clubId])
  @@index([clubId, startsAt])
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  password         String
  name             String
  role             Role               @default(STAFF)
  clubId           String
  club             Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  recurringBookings RecurringBooking[]
  deviceTokens     DeviceToken[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([clubId])
}

/// A staff-app device registered for push notifications ("Nueva reserva pendiente de seña",
/// "Nuevo comprobante para revisar"). One row per physical device/install — a user with two
/// phones has two rows; the same physical app reinstalled gets a new Expo push token and a
/// new row (the old one is pruned once Expo reports it as DeviceNotRegistered).
model DeviceToken {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// Expo push token, e.g. "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]".
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([userId])
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

/// A reservation linking a player to a specific slot.
model Booking {
  id                 String            @id @default(cuid())
  slotId             String
  slot               Slot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  clubId             String
  club               Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerName         String
  playerPhone        String?
  /// DNI the bot captured at booking (digits only), used to validate the payer's identity
  /// when the club has requireDniMatch on. Null otherwise.
  playerDni          String?
  status             BookingStatus     @default(PENDING_PAYMENT)
  notes              String?
  /// Identity of who actually transferred, captured from MercadoPago at confirmation
  /// (for owner visibility / audit). Null until/unless a real transfer confirms it.
  payerCuit          String?
  payerEmail         String?
  payerMpUserId      String?
  bookedByUserId     Int?
  bookedByUser       User?             @relation(fields: [bookedByUserId], references: [id])
  recurringBookingId String?
  recurringBooking   RecurringBooking? @relation(fields: [recurringBookingId], references: [id], onDelete: SetNull)
  /// Amount (cents) the first player must pay to confirm this slot.
  depositCents       Int               @default(0)
  /// Exact amount (cents) the player must transfer. Normally equals the real deposit;
  /// only on a collision with another pending booking in the same whole-peso bucket is
  /// a different centavos tag chosen, so an incoming transfer still maps to exactly one
  /// pending booking during reconciliation. Null for admin-created bookings.
  transferAmountCents Int?
  /// MercadoPago payment ID set once the webhook confirms the payment.
  mpPaymentId        String?
  /// When the pending payment link expires; null for admin-created bookings.
  paymentExpiresAt   DateTime?
  /// When the player sent a transfer receipt photo (RECEIPT verification mode). Null until
  /// a receipt arrives. Drives the panel's "review now" priority and stops the pending from
  /// auto-expiring while it awaits an admin's manual review.
  receiptUploadedAt  DateTime?
  receipts           PaymentReceipt[]
  bookingProducts    BookingProduct[]
  /// When the pre-match WhatsApp reminder was sent (BookingRemindersService, ~1h before
  /// the slot). Null until sent; guards the reminder cron from re-sending on every sweep.
  reminderSentAt     DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([clubId])
  @@index([slotId])
  @@index([recurringBookingId])
  @@index([clubId, status])
  @@index([status, paymentExpiresAt])
  @@index([status, transferAmountCents])
  @@index([status, reminderSentAt])
}

/// A transfer-receipt image a player sent for a booking in RECEIPT verification mode.
/// The bytes live in object storage (Vercel Blob); only the storage key/URL and metadata
/// are persisted here. Cascade-deleted with the booking; also pruned when the booking is
/// confirmed/rejected (the image is no longer needed once the payment is resolved).
model PaymentReceipt {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// Storage backend key/pathname used to fetch or delete the blob.
  storageKey String
  /// Fully-qualified blob URL (server-side only — never exposed to the browser).
  url        String   @db.Text
  mimeType   String
  sizeBytes  Int
  /// Meta media id the image came from (audit / dedup).
  waMediaId  String?
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@index([clubId])
}

/// A product in the club's store (balls, drinks, snacks, accessories, etc.)
model Product {
  id           String          @id @default(cuid())
  clubId       String
  club         Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name         String
  priceCents   Int
  category     ProductCategory @default(OTRO)
  isActive     Boolean         @default(true)
  bookingItems BookingProduct[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([clubId])
}

enum ProductCategory {
  PELOTA
  BEBIDA
  SNACK
  ACCESORIO
  OTRO
}

/// Records which products were consumed during a booked court session.
model BookingProduct {
  id             String   @id @default(cuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  quantity       Int      @default(1)
  /// Snapshot of the product price at the time of sale (cents).
  unitPriceCents Int
  createdAt      DateTime @default(now())

  @@index([bookingId])
  @@index([clubId])
}

/// Maps a Meta WhatsApp Business phone number ID to a club (tenant).
/// The bot uses this to resolve which club owns an incoming message.
model WhatsAppLine {
  id            String   @id @default(cuid())
  /// Meta's phone_number_id from the webhook — globally unique across all clubs.
  phoneNumberId String   @unique
  /// Human-readable phone number for display (e.g. "+54 9 11 1234-5678").
  displayPhone  String
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clubId])
}

/// Bot conversation state for a WhatsApp user within a club.
/// Persists the state machine position and partial booking data between messages.
model ConversationSession {
  id        String   @id @default(cuid())
  /// WhatsApp sender ID (phone in E.164 without '+', e.g. "5491112345678").
  waId      String
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// Current state machine node (BotState enum value stored as string).
  state     String   @default("IDLE")
  /// Partial booking/cancel data accumulated across turns (JSON blob).
  context   Json
  /// Session expires after inactivity; reset to IDLE on next message.
  expiresAt DateTime
  /// "AI" = bot handles the conversation; "HUMAN" = admin has taken over.
  mode      String   @default("AI")
  /// True when the player asked to talk to a human advisor and no staff has replied yet.
  /// Surfaced/notified in the panel; cleared when an admin sends a message or switches mode.
  needsAdvisor Boolean @default(false)
  /// Cached player name from context so the conversations list can display it without loading context.
  playerName String?
  messages  ConversationMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([waId, clubId])
  @@index([clubId])
}

/// Persistent log of every message in a conversation (incoming, bot replies, admin replies).
model ConversationMessage {
  id        String              @id @default(cuid())
  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// "USER" = from the player, "BOT" = generated by the AI, "ADMIN" = sent manually by staff.
  role      String
  content   String              @db.Text
  createdAt DateTime            @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

/// Dedup log of WhatsApp webhook messages already handled. Meta retries webhook
/// deliveries (on slow/non-200 responses), so we record each Meta message id and skip
/// re-processing — prevents double bookings / duplicate LLM calls. Rows are pruned daily.
model ProcessedWebhookMessage {
  /// Meta's message id (wamid…), globally unique per message.
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A weekly recurring reservation created by an admin.
/// When created, it is automatically applied to all matching available slots.
model RecurringBooking {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courtId         String
  court           Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  /// 0 = Sunday, 1 = Monday … 6 = Saturday
  dayOfWeek       Int
  /// "HH:MM" matching one of the defined slot start times
  slotStart       String
  /// "HH:MM" matching one of the defined slot end times
  slotEnd         String
  playerName      String
  playerPhone     String
  priceCents      Int
  notes           String?
  /// Block weekly occurrences only up to (and including) this club-local day. Null = the
  /// default rolling window (WEEKS_AHEAD) with no hard end.
  untilDate       DateTime?
  isActive        Boolean   @default(true)
  createdByUserId Int
  createdByUser   User      @relation(fields: [createdByUserId], references: [id])
  bookings        Booking[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clubId])
  @@index([courtId])
  @@index([clubId, courtId, dayOfWeek])
}
