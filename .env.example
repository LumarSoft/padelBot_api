DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DB_NAME"
JWT_SECRET="change_this_secret"
JWT_EXPIRES_IN="7d"

# Club wall-clock timezone. All slot day-windows and times the bot shows are
# computed in this zone, independent of the server's OS timezone. IANA name.
CLUB_TIMEZONE="America/Argentina/Buenos_Aires"

# OpenAI (bot natural-language understanding)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"             # optional, defaults to gpt-4o-mini
LLM_MAX_CALLS_PER_MIN="12"             # optional — per-user OpenAI call budget (anti-spam), default 12

# Global API rate limit (requests per minute per IP; webhooks are exempt). Optional, default 120.
THROTTLE_LIMIT="120"

# Receipt-photo storage (RECEIPT payment-verification mode).
# RECEIPT_STORAGE_DRIVER: "local" (default) stores files on disk under ./storage/receipts —
# simple for testing, but NOT durable on ephemeral hosts (Railway/Render wipe the disk on
# redeploy). Set to "blob" for production to use Vercel Blob (durable); that also requires
# BLOB_READ_WRITE_TOKEN (create a Blob store in the Vercel dashboard and paste its token).
RECEIPT_STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# WhatsApp Business API (Meta). Canonical names are WHATSAPP_*. The legacy META_VERIFY_TOKEN /
# META_ACCESS_TOKEN / META_APP_SECRET are still read as a fallback, but prefer these.
WHATSAPP_VERIFY_TOKEN="pick_a_random_secret_string"  # the verify token you set in the Meta webhook config
WHATSAPP_TOKEN="EAAxxxxxxxx"          # System User access token from Meta dashboard
WHATSAPP_APP_SECRET="xxxxxxxx"        # App secret from Meta dashboard (for signature verification)
WHATSAPP_API_VERSION="v21.0"          # Graph API version (optional, defaults to v21.0)

# Pre-match booking reminders (BookingRemindersService). A reminder is a business-initiated
# message outside the 24h customer-service window, so it MUST go through a Meta message
# template (HSM) approved in the WhatsApp Business Manager for each club's number — plain
# WHATSAPP_TOKEN free-form text is rejected by Meta for this. Create the template first
# (name below, category UTILITY, body with 3 variables: player name, court, time).
WHATSAPP_REMINDER_TEMPLATE_NAME="recordatorio_turno"  # must match the approved template's name exactly
WHATSAPP_REMINDER_TEMPLATE_LANG="es_AR"               # language code the template was approved in
# Minutes before the slot start to send the reminder (default 60). Keep in sync with the cron
# sweep cadence in BookingRemindersService (every 5 min) — don't set to a value under ~10.
BOOKING_REMINDER_LEAD_MINUTES="60"

# Payments — deposits are paid by bank transfer to the club's MercadoPago alias/CVU.
# Confirmation is automatic: an incoming transfer is matched to a pending booking by
# its exact (unique) amount. PRIMARY path is polling — MercadoPago does NOT webhook
# plain incoming transfers, but exposes them in its payments API, which a cron polls
# every minute (PaymentsService.pollIncomingTransfers). Use PRODUCTION credentials of
# the real account that owns the alias (test users / sandbox don't see real transfers).
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."  # Shared/legacy fallback token (account that owns the alias).
                                        # Used only for clubs that have NOT connected their own MP via OAuth.
WEBHOOK_SECRET="xxxxxxxx"               # MP webhook signing secret (only used if MP ever sends a webhook)

# MercadoPago Connect (OAuth) — lets EACH club link its OWN MercadoPago account so the
# deposit money lands in the club's account and is reconciled with that account's token.
# Create these in the MercadoPago app dashboard (your app's OAuth credentials).
MP_OAUTH_CLIENT_ID="..."                # = your MP application id
MP_OAUTH_CLIENT_SECRET="..."            # MP application client secret
MP_OAUTH_REDIRECT_URI="https://api.tudominio.com/clubs/mercadopago/callback"

# Encryption key for secrets at rest (each club's MP OAuth tokens). REQUIRED for OAuth.
# Generate with: openssl rand -hex 32   (must be 64 hex chars = 32 bytes)
ENCRYPTION_KEY="..."
# Minutes a player has to transfer before the pending booking auto-cancels (default 30).
# Bump it while testing so bookings don't expire mid-test.
PAYMENT_WINDOW_MIN="30"
# How often (seconds) to poll MercadoPago for incoming transfers (default 20). Lower =
# faster confirmation, more API calls — but it only polls while a booking is pending.
PAYMENT_POLL_SECONDS="20"
# Consecutive payment-poll failures before alerting the club (push) and ops (default 3).
PAYMENT_ALERT_FAILURES="3"
# Slack/Discord-compatible webhook that receives ops alerts (poller down, club MP token
# broken, recovery). Optional — alerts always land in the error log regardless.
OPS_ALERT_WEBHOOK_URL=""
# No-shows before the bot demands the FULL court price as the deposit (default 3).
NO_SHOW_FULL_THRESHOLD="3"
# Free-trial length (days) for self-service signups (default 14).
TRIAL_DAYS="14"
# Days the bot keeps serving players after a club's trial/paid period lapses (default 7).
SUBSCRIPTION_GRACE_DAYS="7"
# Shared secret for ops-only provisioning (POST /onboarding/register). Club creation is
# MANAGED — we configure MercadoPago/WhatsApp and create the tenant ourselves. Fails closed.
OPS_ADMIN_SECRET="generate_a_long_random_string"
# Whether THIS instance runs @Cron/@Interval jobs (payments poller, reminders, cleanups).
# Default true. When scaling to 2+ instances set "false" on all but one, or jobs run twice.
RUN_SCHEDULER="true"
# Shared secret for the generic transfer-received bridge (POST /webhooks/transfer), an
# optional alternative source (e.g. a PagaVoz-style notification reader). Fails closed when unset.
TRANSFER_BRIDGE_SECRET="generate_a_long_random_string"
# Investigation flag: when "true", logs the payer data MercadoPago returns for each incoming
# transfer ([MP_DEBUG_PAYER] lines) so we can see if the sender's name is available before
# building name-based reconciliation. Does NOT change matching (still by amount). Leave off in prod.
MP_DEBUG_PAYER="false"
